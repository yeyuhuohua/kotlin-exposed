{
  "name": "hr-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "format": "prettier --write src tests vite.config.ts vitest.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "@lucide/vue": "^1.47.0",
    "chart.js": "^4.5.0",
    "element-plus": "^2.14.6",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.8",
    "typescript": "~7.0.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.0"
  }
}
